# NextAuth Configuration
NEXTAUTH_SECRET=generate-a-random-secret-here
NEXTAUTH_URL=http://localhost:3000

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Google Drive API
GOOGLE_DRIVE_FOLDER_ID=your-google-drive-folder-id
GOOGLE_API_KEY=your-google-api-key

# Admin Email (restrict access to this Google account)
ADMIN_EMAIL=your-admin-email@gmail.com

# Firestore — job description click tracking (optional; links work without it)
FIRESTORE_PROJECT_ID=your-gcp-project-id
# Only needed if your database is not the unnamed "(default)" one.
FIRESTORE_DATABASE_ID=zeste-jd-db
# Full service account JSON on one line. Needs the "Cloud Datastore User" role.
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com"}
# Any random string. Salts the visitor hash so IPs are never stored.
CLICK_HASH_SALT=generate-a-random-string
